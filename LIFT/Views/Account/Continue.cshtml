@model string
@using System.Text.Json
@using System.Security.Claims
@{ Layout = null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Opening LIFT</title></head><body>
<p>Opening your dashboard…</p>
<script>
  const role = @Html.Raw(JsonSerializer.Serialize(User.FindFirstValue(ClaimTypes.Role)));
  if (role === 'client') {
    localStorage.setItem('lift-preview-member-v1', JSON.stringify({
      name: @Html.Raw(JsonSerializer.Serialize(User.Identity?.Name)),
      email: @Html.Raw(JsonSerializer.Serialize(User.FindFirstValue(ClaimTypes.Email))),
      plan: @Html.Raw(JsonSerializer.Serialize(User.FindFirstValue("plan"))),
      preview: true, requiresPersonalization: true
    }));
  }
  location.replace(@Html.Raw(JsonSerializer.Serialize(Model)));
</script></body></html>
