@model LIFT.Models.AdminDashboardVm
@{ Layout = null; }
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Clients | LIFT Admin</title>
<link rel="stylesheet" href="~/Shared/Components/Admin/Sidebar/sidebar.css" /><link rel="stylesheet" href="~/Admin/Dashboard/dashboard.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-mvc.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-polish.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-stms.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-cycle.css" />
<script src="~/Shared/JS/theme.js"></script><script src="~/Shared/Components/Admin/Sidebar/sidebar.js" defer></script><script src="~/Shared/JS/admin-shell.js" defer></script></head>
<body><div class="admin-shell"><partial name="_AdminTopbar" /><lift-admin-sidebar></lift-admin-sidebar><main class="admin-page">
<header class="dashboard-heading"><div><p class="eyebrow">PEOPLE / CLIENTS</p><h1>Clients</h1><p>View client accounts, plans, and account status.</p></div></header>
@if (TempData["Success"] is string success) { <p class="admin-notice" role="status">@success</p> }
@if (TempData["Error"] is string error) { <p class="admin-notice admin-notice-error" role="alert">@error</p> }
<form class="admin-search" asp-action="Clients" method="get"><label for="client-search">Search clients</label><input id="client-search" name="search" value="@Model.Search" placeholder="Name or email" /><select id="directory-filter" aria-label="Filter client status"><option value="all">All statuses</option><option value="active">Active</option><option value="suspended">Suspended</option><option value="blocked">Blocked</option></select><button type="submit">Search</button></form>
<section class="active-section"><div class="stms-section-heading"><h2>Client accounts</h2><span>Page @Model.ClientPage of @Model.ClientPages</span></div>
<div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th scope="col">Client</th><th scope="col">Plan</th><th scope="col">Joined</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach (var client in Model.Clients) {
<tr data-status="@client.Status"><td data-label="Client"><strong>@client.Name</strong><small>@client.Email</small></td><td data-label="Plan">@(client.Plan ?? "No active plan")</td><td data-label="Joined">@client.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td><td data-label="Status"><span class="admin-status">@client.Status</span></td><td data-label="Actions"><div class="admin-row-actions"><button type="button" data-admin-dialog-open="client-view-@client.Id">View</button><button type="button" data-admin-dialog-open="client-edit-@client.Id">Edit</button></div>
<dialog class="admin-edit-dialog" id="client-view-@client.Id"><div class="admin-dialog-heading"><h2>@client.Name</h2><button type="button" data-admin-dialog-close aria-label="Close">×</button></div><dl><dt>Email</dt><dd>@client.Email</dd><dt>Phone</dt><dd>@(client.Profile.Phone ?? "—")</dd><dt>Plan</dt><dd>@(client.Plan ?? "No active plan")</dd><dt>Joined</dt><dd>@client.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</dd><dt>Status</dt><dd>@client.Status</dd><dt>Goal</dt><dd>@(client.Profile.Goal ?? "—")</dd><dt>Health notes</dt><dd>@(client.Profile.HealthNotes ?? "—")</dd></dl></dialog>
<dialog class="admin-edit-dialog admin-client-edit-dialog" id="client-edit-@client.Id"><div class="admin-dialog-heading"><h2>Edit @client.Name</h2><button type="button" data-admin-dialog-close aria-label="Close">×</button></div>
<form asp-action="EditClient" method="post" class="admin-dialog-form admin-client-edit-form">@Html.AntiForgeryToken()<input type="hidden" name="UserId" value="@client.Id" />
<label>Full name<input name="FullName" value="@client.Name" maxlength="120" required /></label><label>Email<input name="Email" type="email" value="@client.Email" maxlength="256" required /></label><label>Phone<input name="Phone" value="@client.Profile.Phone" maxlength="30" /></label><label>Birth date<input name="BirthDate" type="date" value="@client.Profile.BirthDate?.ToString("yyyy-MM-dd")" /></label><label>Account status<select name="Status"><option value="active" selected="@(client.Status == "active")">Active</option><option value="suspended" selected="@(client.Status == "suspended")">Suspended</option><option value="blocked" selected="@(client.Status == "blocked")">Blocked</option></select></label>
<div class="admin-dialog-actions"><button type="button" data-admin-dialog-close>Cancel</button><button type="submit">Save changes</button></div></form></dialog></td></tr>
}
</tbody></table></div>
@if (Model.Clients.Count == 0) { <p>No clients match this search.</p> }
<nav class="admin-pager" aria-label="Client pages"><span>Page @Model.ClientPage of @Model.ClientPages</span>@if (Model.ClientPage > 1) { <a asp-action="Clients" asp-route-search="@Model.Search" asp-route-page="@(Model.ClientPage - 1)">Previous</a> }@if (Model.ClientPage < Model.ClientPages) { <a asp-action="Clients" asp-route-search="@Model.Search" asp-route-page="@(Model.ClientPage + 1)">Next</a> }</nav></section>
</main></div></body></html>
