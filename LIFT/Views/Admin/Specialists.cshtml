@model LIFT.Models.AdminDashboardVm
@{ Layout = null; }
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Coaches and nutritionists | LIFT Admin</title>
<link rel="stylesheet" href="~/Shared/Components/Admin/Sidebar/sidebar.css" /><link rel="stylesheet" href="~/Admin/Dashboard/dashboard.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-mvc.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-polish.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-stms.css" /><link rel="stylesheet" href="~/Shared/CSS/admin-cycle.css" />
<script src="~/Shared/JS/theme.js"></script><script src="~/Shared/Components/Admin/Sidebar/sidebar.js" defer></script><script src="~/Shared/JS/admin-shell.js" defer></script></head>
<body><div class="admin-shell"><partial name="_AdminTopbar" /><lift-admin-sidebar></lift-admin-sidebar><main class="admin-page">
<header class="dashboard-heading"><div><p class="eyebrow">PEOPLE / SPECIALISTS</p><h1>Coaches &amp; nutritionists</h1><p>Review specialists and manage active accounts.</p></div></header>
@if (TempData["Success"] is string success) { <p class="admin-notice" role="status">@success</p> }
@if (TempData["Error"] is string error) { <p class="admin-notice admin-notice-error" role="alert">@error</p> }
<section class="active-section"><div class="stms-section-heading"><h2>Pending applications</h2><span>@Model.Pending.Count to review</span></div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th scope="col">Applicant</th><th scope="col">Role and specialty</th><th scope="col">Documents</th><th scope="col">Applied</th><th scope="col">Action</th></tr></thead><tbody>
@foreach (var specialist in Model.Pending) { <tr><td data-label="Applicant"><strong>@specialist.Name</strong><small>@specialist.Email</small></td><td data-label="Role and specialty"><span class="admin-status">@specialist.Role</span> @specialist.Specialty</td><td data-label="Documents">@specialist.CertificateCount certificates</td><td data-label="Applied">@specialist.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td><td data-label="Action"><button type="button" class="admin-row-action" data-review-url="@Url.Action("Review", "Admin", new { id = specialist.Id })">Review ↗</button></td></tr> }
</tbody></table></div>@if (Model.Pending.Count == 0) { <p>No pending applications.</p> }</section>
<form class="admin-search" asp-action="Specialists" method="get"><label for="specialist-search">Search specialists</label><input id="specialist-search" name="search" value="@Model.Search" placeholder="Name or email" /><select id="directory-filter" aria-label="Filter specialist status"><option value="all">All statuses</option><option value="active">Active</option><option value="suspended">Suspended</option><option value="blocked">Blocked</option></select><select id="role-filter" aria-label="Filter specialist role"><option value="all">All roles</option><option value="coach">Coaches</option><option value="nutritionist">Nutritionists</option></select><button type="submit">Search</button></form>
<section class="active-section"><div class="stms-section-heading"><h2>Specialist accounts</h2><span>Page @Model.SpecialistPage of @Model.SpecialistPages</span></div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th scope="col">Specialist</th><th scope="col">Role</th><th scope="col">Specialty</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach (var specialist in Model.Active) { <tr data-status="@specialist.Status" data-role="@specialist.Role"><td data-label="Specialist"><strong>@specialist.Name</strong><small>@specialist.Email</small></td><td data-label="Role">@specialist.Role</td><td data-label="Specialty">@specialist.Specialty</td><td data-label="Status"><span class="admin-status">@specialist.Status</span></td><td data-label="Actions"><div class="admin-row-actions"><button type="button" data-admin-dialog-open="specialist-view-@specialist.Id">View</button><button type="button" data-admin-dialog-open="specialist-edit-@specialist.Id">Edit</button></div><dialog class="admin-edit-dialog" id="specialist-view-@specialist.Id"><div class="admin-dialog-heading"><h2>@specialist.Name</h2><button type="button" data-admin-dialog-close aria-label="Close">×</button></div><dl><dt>Email</dt><dd>@specialist.Email</dd><dt>Role</dt><dd>@specialist.Role</dd><dt>Specialty</dt><dd>@specialist.Specialty</dd><dt>Status</dt><dd>@specialist.Status</dd><dt>Client capacity</dt><dd>@specialist.Capacity</dd></dl></dialog><dialog class="admin-edit-dialog" id="specialist-edit-@specialist.Id"><div class="admin-dialog-heading"><h2>Manage @specialist.Name</h2><button type="button" data-admin-dialog-close aria-label="Close">×</button></div><form asp-action="ChangeAccountStatus" method="post" class="admin-dialog-form">@Html.AntiForgeryToken()<input type="hidden" name="UserId" value="@specialist.Id" /><input type="hidden" name="returnTo" value="specialists" /><label>Account status<select name="Status"><option value="active" selected="@(specialist.Status == "active")">Active</option><option value="suspended" selected="@(specialist.Status == "suspended")">Suspended</option><option value="blocked" selected="@(specialist.Status == "blocked")">Blocked</option></select></label><div class="admin-dialog-actions"><button type="button" data-admin-dialog-close>Cancel</button><button type="submit">Save changes</button></div></form></dialog></td></tr> }
</tbody></table></div>@if (Model.Active.Count == 0) { <p>No specialists match this search.</p> }<nav class="admin-pager" aria-label="Specialist pages"><span>Page @Model.SpecialistPage of @Model.SpecialistPages</span>@if (Model.SpecialistPage > 1) { <a asp-action="Specialists" asp-route-search="@Model.Search" asp-route-page="@(Model.SpecialistPage - 1)">Previous</a> }@if (Model.SpecialistPage < Model.SpecialistPages) { <a asp-action="Specialists" asp-route-search="@Model.Search" asp-route-page="@(Model.SpecialistPage + 1)">Next</a> }</nav></section>
<dialog id="review-popup" class="admin-review-popup" aria-label="Specialist application review"><button type="button" data-admin-dialog-close>Close ×</button><iframe title="Specialist application review"></iframe></dialog></main></div></body></html>
