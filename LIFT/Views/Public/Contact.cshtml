@model LIFT.Models.ContactForm
@{ Layout = null; }
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101713"><meta name="description" content="Contact LIFT about your plan, support options, or the platform.">
  <title>Contact LIFT | LIFT</title>
  
  
  <link rel="stylesheet" href="/Shared/CSS/theme.css">
  <link rel="stylesheet" href="/Public/LandingPage/landing-sections.css">
  <link rel="stylesheet" href="/Public/editorial-pages.css">
  <link rel="stylesheet" href="/Public/public-shell.css">
  <script src="/Shared/JS/theme.js"></script>
  <script src="/Public/public-navbar.js" defer></script>
  <script src="/Public/public-footer.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a><lift-navbar></lift-navbar>
  <main id="main" class="contact-page">
    <section class="post-section contact-section" id="contact" aria-labelledby="contact-title"><div class="post-wrap contact-stage"><span class="section-pill contact-pill">CONTACT US</span><div class="contact-heading"><h1 id="contact-title">We’re here <em>to help you.</em></h1><p>Have a question about LIFT, your plan, or your support options? Send us a message and we’ll get back to you.</p></div>
      <div class="contact-image contact-image--one" aria-hidden="true"><img src="/Public/LandingPage/assets/contact-move.jpg" alt="" loading="lazy" decoding="async"></div><div class="contact-image contact-image--two" aria-hidden="true"><img src="/Public/LandingPage/assets/contact-fuel.jpg" alt="" loading="lazy" decoding="async"></div><div class="contact-image contact-image--three" aria-hidden="true"><img src="/Public/LandingPage/assets/contact-recover.jpg" alt="" loading="lazy" decoding="async"></div><div class="contact-image contact-image--four" aria-hidden="true"><img src="/Public/LandingPage/assets/contact-coach.jpg" alt="" loading="lazy" decoding="async"></div>
      <form class="landing-contact-form" id="landing-contact-form" asp-controller="Public" asp-action="Contact" method="post">@Html.AntiForgeryToken()<div class="contact-form-top"><span>YOUR MESSAGE</span><span>01 — 05</span></div><div asp-validation-summary="All" role="alert"></div><div class="contact-fields"><label for="contact-name">Full Name<input id="contact-name" name="Name" type="text" autocomplete="name" placeholder="Your full name" maxlength="100" value="@Model.Name" required></label><label for="contact-email">Email<input id="contact-email" name="Email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="256" value="@Model.Email" required></label><label for="contact-address">Address<input id="contact-address" name="Address" type="text" autocomplete="street-address" placeholder="Your address" maxlength="180" value="@Model.Address"></label><label for="contact-phone">Phone<input id="contact-phone" name="Phone" type="tel" autocomplete="tel" placeholder="Your phone number" maxlength="40" value="@Model.Phone"></label><label class="message-field" for="contact-message">Message<textarea id="contact-message" name="Message" rows="5" placeholder="How can we help?" maxlength="2000" required>@Model.Message</textarea></label></div><div class="contact-form-end"><p>Messages are reviewed by the LIFT team. Email replies are not connected yet.</p><button type="submit">SEND MESSAGE <span aria-hidden="true">→</span></button></div>@if (TempData["ContactSuccess"] is string success) { <p class="contact-status" id="contact-status" role="status">@success</p> }</form>
    </div></section>

  </main><lift-footer></lift-footer>
</body>
</html>






